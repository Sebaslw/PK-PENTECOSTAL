{
  "name": "pk-pentecostal",
  "productName": "PK-PENTECOSTAL",
  "version": "2.0.10",
  "description": "Biblia y canciones en vivo para proyector, OBS y celulares",
  "author": "Sebastian Lopez · IPUC Natania 6° Etapa",
  "homepage": "https://sebaslw.github.io/pk-pentecostal.io/",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "servidor": "node PK-PENTECOSTAL/server.js --abrir",
    "probar": "node electron/pruebas.js",
    "probar-obs": "node electron/prueba-obs.js && electron electron/prueba-obs-panel.js",
    "probar-letra": "node electron/prueba-letra.js",
    "probar-tamano": "electron electron/prueba-tamano.js",
    "miniaturas": "electron electron/miniaturas-fabrica.js",
    "dist": "electron electron/miniaturas-fabrica.js && electron-builder --win --x64 --publish never",
    "probar-canciones": "node electron/prueba-canciones.js",
    "probar-enlinea": "electron electron/prueba-enlinea-panel.js",
    "probar-biblias": "node electron/prueba-biblias.js && electron electron/prueba-biblias-panel.js",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "probar-app": "node electron/prueba-app.js",
    "poner-version": "node electron/poner-version.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "co.ipuc.natania.pkpentecostal",
    "productName": "PK-PENTECOSTAL",
    "copyright": "Hecho por Sebastian Lopez · IPUC Natania 6° Etapa",
    "asar": true,
    "asarUnpack": [
      "PK-PENTECOSTAL/zona-wifi.ps1"
    ],
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "package.json",
      "electron/main.js",
      "electron/splash.html",
      "PK-PENTECOSTAL/**/*",
      "!PK-PENTECOSTAL/traductor/node_modules{,/**}",
      "!PK-PENTECOSTAL/traductor/modelos{,/**}",
      "!PK-PENTECOSTAL/traductor/*.log",
      "!PK-PENTECOSTAL/{config.json,config.json.tmp}",
      "!PK-PENTECOSTAL/{respaldos,respaldo-logo-anterior}{,/**}",
      "!PK-PENTECOSTAL/obs/{stingers,laterales,overlays}.json",
      "!PK-PENTECOSTAL/obs/*.tmp",
      "!PK-PENTECOSTAL/obs/biblioteca/{animaciones,fondos,fuentes,imagenes,logos,overlays,proyectorp,sonidos}{,/**}",
      "!PK-PENTECOSTAL/obs/biblioteca/pk/logo-ipuc.webp",
      "biblias/**/*",
      "cancioneros/**/*",
      "fondos/**/*",
      "fondos-miniaturas/**/*",
      "!fondos/Subidos{,/**}",
      "!fondos/VIDEOS ANIMADOS/Particles Blue Bokeh*",
      "css/**/*",
      "Manual PK-PENTECOSTAL.pdf"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "PK-PENTECOSTAL/pk-pentecostal.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "PK-PENTECOSTAL/public/icono-512.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PK-PENTECOSTAL-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "PK-PENTECOSTAL ${version}",
      "artifactName": "PK-PENTECOSTAL-${version}-mac.${ext}"
    },
    "linux": {
      "icon": "PK-PENTECOSTAL/public/icono-512.png",
      "category": "AudioVideo",
      "synopsis": "Biblia y canciones en vivo para proyector, OBS y celulares",
      "maintainer": "Sebastian Lopez <129629599+Sebaslw@users.noreply.github.com>",
      "vendor": "IPUC Natania 6° Etapa",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "PK-PENTECOSTAL-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PK-PENTECOSTAL",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "PK-PENTECOSTAL/pk-pentecostal.ico",
      "uninstallerIcon": "PK-PENTECOSTAL/pk-pentecostal.ico",
      "uninstallDisplayName": "PK-PENTECOSTAL",
      "language": "3082",
      "artifactName": "PK-PENTECOSTAL-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PK-PENTECOSTAL-Portable-${version}.${ext}",
      "unpackDirName": "PK-PENTECOSTAL-${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sebaslw",
        "repo": "PK-PENTECOSTAL",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
